{
  "entity": {
    "sensor": {
      "heating_rate": {
        "default": "mdi:thermometer-chevron-up"
      }
    },
    "switch": {
      "absence": {
        "default": "mdi:home-outline",
        "state": {
          "on": "mdi:home-export-outline"
        }
      }
    }
  },
  "services": {
    "resync": {
      "service": "mdi:calendar-sync"
    },
    "skip_next": {
      "service": "mdi:debug-step-over"
    },
    "add_dates": {
      "service": "mdi:calendar-plus"
    },
    "remove_dates": {
      "service": "mdi:calendar-remove"
    },
    "set_absence": {
      "service": "mdi:home-export-outline"
    },
    "end_absence": {
      "service": "mdi:home-import-outline"
    },
    "advance": {
      "service": "mdi:skip-next"
    },
    "apply_event": {
      "service": "mdi:play-circle-outline"
    },
    "resume": {
      "service": "mdi:calendar-refresh"
    },
    "reset_learning": {
      "service": "mdi:restart"
    }
  }
}
